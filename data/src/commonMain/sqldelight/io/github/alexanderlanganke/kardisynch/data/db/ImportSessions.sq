CREATE TABLE ImportSessions (
    id TEXT NOT NULL PRIMARY KEY,
    timestamp TEXT NOT NULL,
    status TEXT,
    summary TEXT
);

insertImportSession:
INSERT OR REPLACE INTO ImportSessions(id, timestamp, status, summary) VALUES (?, ?, ?, ?);

selectRecentImportSessions:
SELECT * FROM ImportSessions ORDER BY timestamp DESC LIMIT ?;

deleteAllImportSessions:
DELETE FROM ImportSessions;
