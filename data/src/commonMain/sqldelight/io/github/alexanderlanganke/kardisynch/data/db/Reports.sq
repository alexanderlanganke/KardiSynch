CREATE TABLE Reports (
    id TEXT NOT NULL PRIMARY KEY,
    patientId TEXT NOT NULL,
    manufacturer TEXT,
    interrogationDate TEXT NOT NULL,
    hospitalVisitId TEXT,
    deviceType TEXT,
    deviceModel TEXT,
    deviceSerialNumber TEXT,
    rawText TEXT,
    data TEXT,
    -- Battery voltage at this visit (issue #198's trend chart) — the only
    -- battery/lead field promoted from visit.xml into the queryable index;
    -- everything else about a report still requires re-reading visit.xml.
    batteryVoltageValue REAL,
    batteryVoltageUnit TEXT,
    FOREIGN KEY (patientId) REFERENCES Patients(id)
);

CREATE INDEX idx_reports_patient_id ON Reports(patientId);
CREATE INDEX idx_reports_interrogation_date ON Reports(interrogationDate);

insertReport:
INSERT OR REPLACE INTO Reports(id, patientId, manufacturer, interrogationDate, hospitalVisitId, deviceType, deviceModel, deviceSerialNumber, rawText, data, batteryVoltageValue, batteryVoltageUnit)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectReportsByPatientId:
SELECT * FROM Reports WHERE patientId = ? ORDER BY interrogationDate DESC;

selectReportById:
SELECT * FROM Reports WHERE id = ?;

selectReportsByDatePrefix:
SELECT * FROM Reports WHERE patientId = ? AND interrogationDate LIKE ? || '%';

updateReportPatientId:
UPDATE Reports SET patientId = ? WHERE id = ?;

deleteReport:
DELETE FROM Reports WHERE id = ?;

deleteReportsForPatient:
DELETE FROM Reports WHERE patientId = ?;

deleteAllReports:
DELETE FROM Reports;
