{
  "name": "app",
  "version": "1.0.0",
  "description": "A self contained electron based database, renderer and pdf viewer for IECD interrogations",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "vite",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:e2e": "npm run build && xvfb-run --auto-servernum --server-args=\"-screen 0 1280x960x24\" -- playwright test",
    "test:e2e:ci": "npm run build && cross-os e2e-test-runner",
    "package": "electron-builder",
    "postinstall": "@electron/rebuild"
  },
  "cross-os": {
    "e2e-test-runner": {
      "linux": "xvfb-run --auto-servernum --server-args='-screen 0 1280x960x24' -- playwright test",
      "win32": "playwright test",
      "darwin": "playwright test"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexanderlanganke/KardiSynch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alexanderlanganke/KardiSynch/issues"
  },
  "homepage": "https://github.com/alexanderlanganke/KardiSynch#readme",
  "build": {
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "publish": {
      "provider": "github"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@playwright/test": "^1.56.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "cross-os": "^1.3.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "sqlite3": "^5.1.7",
    "svelte": "^5.43.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@types/pdf-parse": "^1.1.5",
    "fast-xml-parser": "^5.3.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.394",
    "svelte-dnd-action": "^0.9.67",
    "tesseract.js": "^6.0.1",
    "uuid": "^13.0.0"
  }
}
