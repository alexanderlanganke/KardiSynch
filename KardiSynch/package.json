{
  "name": "app",
  "version": "1.0.0",
  "description": "A self contained electron based database, renderer and pdf viewer for IECD interrogations",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "dev": "vite",
    "dev:debug": "electron . --remote-debugging-port=9222",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:e2e": "npm run build && xvfb-run --auto-servernum --server-args=\"-screen 0 1280x960x24\" -- playwright test",
    "test:e2e:ci": "npm run build && cross-os e2e-test-runner",
    "package": "electron-builder",
    "postinstall": "npx @electron/rebuild"
  },
  "cross-os": {
    "e2e-test-runner": {
      "linux": "xvfb-run --auto-servernum --server-args='-screen 0 1280x960x24' -- playwright test",
      "win32": "playwright test",
      "darwin": "playwright test"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexanderlanganke/KardiSynch.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alexanderlanganke/KardiSynch/issues"
  },
  "homepage": "https://github.com/alexanderlanganke/KardiSynch#readme",
  "build": {
    "npmRebuild": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "publish": {
      "provider": "github"
    },
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "cross-os": "^1.3.0",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/pdf-parse": "^1.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.3.1",
    "lucide-react": "^0.552.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.2.0",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^6.0.1",
    "uuid": "^13.0.0"
  }
}
