{
    "git": {
        "commitMessage": "chore: release v${version}",
        "tagName": "v${version}",
        "requireCleanWorkingDir": false
    },
    "github": {
        "release": false,
        "tokenRef": "GITHUB_TOKEN"
    },
    "npm": {
        "publish": false
    },
    "hooks": {
        "after:bump": "npm run build"
    }
}